{
  "expo": {
    "name": "QuickStash",
    "slug": "quickstash",
    "version": "1.0.0",
    "scheme": "com.quickstash.app",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-share-intent"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "enableFullScreenImage_legacy": true,
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F5",
      "statusBar": {
        "backgroundColor": "white",
        "style": "dark"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.quickstash.app",
            "CFBundleURLSchemes": ["com.quickstash.app"]
          }
        ],
        "NSUserActivityTypes": ["NSUserActivityTypeBrowsingWeb"]
      }
    },
    "android": {
      "package": "com.quickstash.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.quickstash.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "897d3621-6f5c-44e5-9387-a57da9c124f1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/301ad4bf-3f5e-4de0-81ff-5d00d11ce1ad"
    }
  }
}
